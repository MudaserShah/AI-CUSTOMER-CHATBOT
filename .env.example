# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# PostgreSQL connection string (required — app fails to start without it)
POSTGRES_URI=postgresql://USERNAME:PASSWORD@localhost:5432/ai_customer_chatbot

# JWT signing secret (required). Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY_MINUTES=60

# Comma-separated list of frontend origins allowed to call this API.
# Leave empty in local dev if you're testing with curl/Postman (no browser).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OpenRouter LLM API key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Qdrant vector DB (required)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Optional overrides (sensible defaults already set in src/rag/config.py)
# QDRANT_COLLECTION=customer_knowledge
# EMBEDDING_PROVIDER=huggingface
# UPLOADS_DIR=uploads
# MARKDOWN_DIR=markdown_files
# MAX_UPLOAD_SIZE_MB=50
