diff --git a/frontend/src/ChatPanel.tsx b/frontend/src/ChatPanel.tsx
new file mode 100644
index 0000000..4f1fad6
--- /dev/null
+++ b/frontend/src/ChatPanel.tsx
@@ -0,0 +1,277 @@
+import { Fragment, useEffect, useLayoutEffect, useRef, useState } from "react";
+import type { ReactNode } from "react";
+import "./chat.css";
+
+export type ChatMessage = {
+  id: string;
+  role: "user" | "assistant";
+  content: string;
+  time: number;
+  error?: boolean;
+};
+
+type Props = {
+  open: boolean;
+  messages: ChatMessage[];
+  sending: boolean;
+  customerId?: string;
+  customerName?: string;
+  disabled: boolean;
+  onSend: (text: string) => void;
+  onClose: () => void;
+  onNewChat: () => void;
+  onRetry: () => void;
+};
+
+const SUGGESTIONS = [
+  { icon: "📦", label: "Where is my latest order?", text: "Show me my latest order." },
+  { icon: "↩︎", label: "I want to return something", text: "I want to request a refund." },
+  { icon: "🧾", label: "Check my refund status", text: "Do I have a refund request?" },
+  { icon: "📋", label: "What is the refund policy?", text: "What is your refund policy?" },
+];
+
+const timeFmt = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" });
+const dayFmt = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "short", day: "numeric" });
+
+function dayLabel(ts: number) {
+  const d = new Date(ts);
+  const today = new Date();
+  const yesterday = new Date();
+  yesterday.setDate(today.getDate() - 1);
+  if (d.toDateString() === today.toDateString()) return "Today";
+  if (d.toDateString() === yesterday.toDateString()) return "Yesterday";
+  return dayFmt.format(d);
+}
+
+/* ---------- tiny dependency-free markdown renderer ---------- */
+
+function inline(text: string, keyPrefix: string): ReactNode[] {
+  // **bold**, `code`, and order/ID-looking tokens (#12345)
+  const parts = text.split(/(\*\*[^*]+\*\*|`[^`]+`|#\d{3,})/g);
+  return parts.map((part, i) => {
+    const key = `${keyPrefix}-${i}`;
+    if (part.startsWith("**") && part.endsWith("**") && part.length > 4)
+      return <strong key={key}>{part.slice(2, -2)}</strong>;
+    if (part.startsWith("`") && part.endsWith("`") && part.length > 2)
+      return <code key={key}>{part.slice(1, -1)}</code>;
+    if (/^#\d{3,}$/.test(part)) return <span className="cp-chip" key={key}>{part}</span>;
+    return <Fragment key={key}>{part}</Fragment>;
+  });
+}
+
+function renderRich(content: string): ReactNode {
+  const lines = content.replace(/\r/g, "").split("\n");
+  const blocks: ReactNode[] = [];
+  let list: { ordered: boolean; items: string[] } | null = null;
+  let para: string[] = [];
+
+  const flushPara = () => {
+    if (para.length) {
+      const idx = blocks.length;
+      blocks.push(
+        <p key={`p${idx}`}>
+          {para.map((l, i) => (
+            <Fragment key={i}>
+              {i > 0 && <br />}
+              {inline(l, `p${idx}-${i}`)}
+            </Fragment>
+          ))}
+        </p>,
+      );
+      para = [];
+    }
+  };
+  const flushList = () => {
+    if (list) {
+      const idx = blocks.length;
+      const items = list.items.map((it, i) => <li key={i}>{inline(it, `l${idx}-${i}`)}</li>);
+      blocks.push(list.ordered ? <ol key={`l${idx}`}>{items}</ol> : <ul key={`l${idx}`}>{items}</ul>);
+      list = null;
+    }
+  };
+
+  for (const raw of lines) {
+    const line = raw.trimEnd();
+    const bullet = line.match(/^\s*[-*•]\s+(.*)$/);
+    const numbered = line.match(/^\s*\d+[.)]\s+(.*)$/);
+    if (bullet || numbered) {
+      flushPara();
+      const ordered = !!numbered;
+      if (list && list.ordered !== ordered) flushList();
+      if (!list) list = { ordered, items: [] };
+      list.items.push((bullet || numbered)![1]);
+    } else if (!line.trim()) {
+      flushPara();
+      flushList();
+    } else {
+      flushList();
+      para.push(line);
+    }
+  }
+  flushPara();
+  flushList();
+  return blocks;
+}
+
+/* ---------- component ---------- */
+
+export default function ChatPanel({
+  open, messages, sending, customerId, customerName, disabled,
+  onSend, onClose, onNewChat, onRetry,
+}: Props) {
+  const [draft, setDraft] = useState("");
+  const [expanded, setExpanded] = useState(false);
+  const [atBottom, setAtBottom] = useState(true);
+  const bodyRef = useRef<HTMLDivElement>(null);
+  const endRef = useRef<HTMLDivElement>(null);
+  const inputRef = useRef<HTMLTextAreaElement>(null);
+
+  useEffect(() => {
+    if (open) inputRef.current?.focus();
+  }, [open]);
+
+  useEffect(() => {
+    if (atBottom) endRef.current?.scrollIntoView({ behavior: "smooth", block: "end" });
+  }, [messages, sending, atBottom]);
+
+  useLayoutEffect(() => {
+    const el = inputRef.current;
+    if (!el) return;
+    el.style.height = "auto";
+    el.style.height = `${Math.min(el.scrollHeight, 120)}px`;
+  }, [draft]);
+
+  if (!open) return null;
+
+  function submit() {
+    const text = draft.trim();
+    if (!text || sending || disabled) return;
+    onSend(text);
+    setDraft("");
+    setAtBottom(true);
+  }
+
+  function onScroll() {
+    const el = bodyRef.current;
+    if (!el) return;
+    setAtBottom(el.scrollHeight - el.scrollTop - el.clientHeight < 80);
+  }
+
+  const lastIsError = messages.length > 0 && messages[messages.length - 1].error;
+  const firstName = customerName?.split(" ")[0];
+
+  return (
+    <section className={`cp-panel ${expanded ? "expanded" : ""}`} role="dialog" aria-label="TechNest support chat">
+      <header className="cp-head">
+        <div className="cp-head-avatar">
+          <span>AI</span>
+          <i className="cp-online" />
+        </div>
+        <div className="cp-head-text">
+          <h3>TechNest Support</h3>
+          <small>
+            <i className="cp-dot" /> Online · usually replies instantly
+          </small>
+        </div>
+        <div className="cp-head-actions">
+          <button type="button" onClick={onNewChat} title="Start a new chat" aria-label="Start a new chat">＋</button>
+          <button type="button" className="cp-hide-mobile" onClick={() => setExpanded((v) => !v)} title={expanded ? "Shrink" : "Expand"} aria-label="Toggle size">
+            {expanded ? "⤡" : "⤢"}
+          </button>
+          <button type="button" onClick={onClose} title="Close" aria-label="Close chat">✕</button>
+        </div>
+      </header>
+
+      <div className="cp-body" ref={bodyRef} onScroll={onScroll}>
+        {messages.length === 0 ? (
+          <div className="cp-welcome">
+            <div className="cp-welcome-avatar">AI</div>
+            <h4>Hi{firstName ? `, ${firstName}` : ""} 👋</h4>
+            <p>I can check your orders, track delivery and handle refund requests. What do you need?</p>
+            <div className="cp-suggestions">
+              {SUGGESTIONS.map((s) => (
+                <button key={s.label} type="button" disabled={sending || disabled} onClick={() => onSend(s.text)}>
+                  <span>{s.icon}</span>
+                  {s.label}
+                </button>
+              ))}
+            </div>
+          </div>
+        ) : (
+          <div className="cp-thread">
+            {messages.map((m, i) => {
+              const prev = messages[i - 1];
+              const next = messages[i + 1];
+              const newDay = !prev || new Date(prev.time).toDateString() !== new Date(m.time).toDateString();
+              const firstInGroup = newDay || !prev || prev.role !== m.role;
+              const lastInGroup = !next || next.role !== m.role || next.time - m.time > 5 * 60_000;
+              const mine = m.role === "user";
+              return (
+                <Fragment key={m.id}>
+                  {newDay && <div className="cp-day"><span>{dayLabel(m.time)}</span></div>}
+                  <div className={`cp-row ${mine ? "mine" : "theirs"} ${firstInGroup ? "first" : ""}`}>
+                    {!mine && <div className={`cp-mini-avatar ${lastInGroup ? "" : "ghost"}`}>AI</div>}
+                    <div className="cp-col">
+                      {firstInGroup && <div className="cp-name">{mine ? "You" : "TechNest AI"}</div>}
+                      <div className={`cp-bubble ${m.error ? "error" : ""} ${lastInGroup ? "tail" : ""}`}>
+                        {mine ? <p>{m.content}</p> : renderRich(m.content)}
+                      </div>
+                      {lastInGroup && <div className="cp-time">{timeFmt.format(m.time)}</div>}
+                    </div>
+                  </div>
+                </Fragment>
+              );
+            })}
+
+            {sending && (
+              <div className="cp-row theirs first">
+                <div className="cp-mini-avatar">AI</div>
+                <div className="cp-col">
+                  <div className="cp-bubble typing" aria-label="Assistant is typing">
+                    <span /><span /><span />
+                  </div>
+                </div>
+              </div>
+            )}
+
+            {lastIsError && !sending && (
+              <button type="button" className="cp-retry" onClick={onRetry}>↻ Try again</button>
+            )}
+          </div>
+        )}
+        <div ref={endRef} />
+      </div>
+
+      {!atBottom && messages.length > 0 && (
+        <button type="button" className="cp-jump" onClick={() => endRef.current?.scrollIntoView({ behavior: "smooth" })}>
+          ↓ New messages
+        </button>
+      )}
+
+      <footer className="cp-foot">
+        <div className="cp-compose">
+          <textarea
+            ref={inputRef}
+            rows={1}
+            value={draft}
+            disabled={disabled}
+            placeholder={disabled ? "Place an order to start chatting" : "Type your message…"}
+            onChange={(e) => setDraft(e.target.value)}
+            onKeyDown={(e) => {
+              if (e.key === "Enter" && !e.shiftKey && !e.nativeEvent.isComposing) {
+                e.preventDefault();
+                submit();
+              }
+            }}
+          />
+          <button type="button" className="cp-send" onClick={submit} disabled={!draft.trim() || sending || disabled} aria-label="Send message">
+            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
+          </button>
+        </div>
+        <div className="cp-foot-note">
+          {customerId ? <>Secure session · <code>{customerId}</code></> : "AI can make mistakes — verify important details."}
+        </div>
+      </footer>
+    </section>
+  );
+}
diff --git a/frontend/src/chat.css b/frontend/src/chat.css
new file mode 100644
index 0000000..35fc255
--- /dev/null
+++ b/frontend/src/chat.css
@@ -0,0 +1,98 @@
+/* ===== TechNest chat panel ===== */
+.chat-launcher { position: fixed; right: 24px; bottom: 24px; z-index: 55; display: flex; align-items: center; gap: 10px; border: 0; background: var(--accent); color: #17120b; padding: 8px 18px 8px 8px; border-radius: 999px; box-shadow: 0 10px 34px rgba(232,163,58,.35); transition: transform .15s ease, box-shadow .15s ease; }
+.chat-launcher:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(232,163,58,.45); }
+.chat-launcher span { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: #17120b; color: var(--accent); font-size: 11px; font-weight: 900; }
+.chat-launcher strong { font-size: 13px; }
+
+.cp-panel { position: fixed; right: 24px; bottom: 92px; z-index: 60; width: min(400px, calc(100vw - 32px)); height: min(640px, calc(100vh - 120px)); display: flex; flex-direction: column; background: #0e0f12; border: 1px solid var(--border); border-radius: 22px; box-shadow: 0 30px 90px rgba(0,0,0,.6); overflow: hidden; animation: cp-pop .18s ease-out; transition: width .2s ease, height .2s ease; }
+.cp-panel.expanded { width: min(720px, calc(100vw - 48px)); height: calc(100vh - 120px); }
+@keyframes cp-pop { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
+
+/* header */
+.cp-head { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 16px; background: linear-gradient(180deg, #17181d, #121317); border-bottom: 1px solid var(--border); }
+.cp-head-avatar { position: relative; width: 40px; height: 40px; border-radius: 13px; background: var(--accent); color: #17120b; display: grid; place-items: center; font-weight: 900; font-size: 12px; flex: none; }
+.cp-online { position: absolute; right: -3px; bottom: -3px; width: 12px; height: 12px; border-radius: 50%; background: var(--success); border: 2px solid #17181d; }
+.cp-head-text { flex: 1; min-width: 0; }
+.cp-head-text h3 { margin: 0; font-size: 15px; }
+.cp-head-text small { display: flex; align-items: center; gap: 6px; margin-top: 3px; color: var(--muted); font-size: 11px; }
+.cp-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); display: inline-block; }
+.cp-head-actions { display: flex; gap: 4px; }
+.cp-head-actions button { width: 32px; height: 32px; border: 0; border-radius: 9px; background: transparent; color: var(--muted); font-size: 15px; }
+.cp-head-actions button:hover { background: var(--surface-3); color: var(--text); }
+
+/* body */
+.cp-body { flex: 1; overflow-y: auto; padding: 18px 14px 8px; background: radial-gradient(circle at 100% 0%, rgba(232,163,58,.05), transparent 40%); scroll-behavior: smooth; }
+.cp-body::-webkit-scrollbar { width: 6px; }
+.cp-body::-webkit-scrollbar-thumb { background: var(--surface-3); border-radius: 6px; }
+.cp-thread { display: flex; flex-direction: column; }
+
+.cp-day { display: flex; align-items: center; gap: 10px; margin: 6px 0 14px; color: #6e737e; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
+.cp-day::before, .cp-day::after { content: ""; flex: 1; height: 1px; background: var(--border); }
+
+.cp-row { display: flex; align-items: flex-end; gap: 8px; margin-top: 3px; animation: cp-in .2s ease-out; }
+.cp-row.first { margin-top: 14px; }
+.cp-row.mine { justify-content: flex-end; }
+@keyframes cp-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+.cp-col { display: flex; flex-direction: column; max-width: 82%; min-width: 0; }
+.cp-row.mine .cp-col { align-items: flex-end; }
+.cp-name { font-size: 10px; color: #7b808c; margin: 0 6px 4px; letter-spacing: .02em; }
+.cp-time { font-size: 10px; color: #5f646f; margin: 4px 6px 0; }
+
+.cp-mini-avatar { width: 26px; height: 26px; flex: none; border-radius: 9px; background: var(--surface-3); border: 1px solid var(--border); color: var(--accent); display: grid; place-items: center; font-size: 9px; font-weight: 900; margin-bottom: 18px; }
+.cp-mini-avatar.ghost { visibility: hidden; }
+
+.cp-bubble { padding: 10px 14px; font-size: 13.5px; line-height: 1.55; border-radius: 18px; overflow-wrap: anywhere; }
+.cp-bubble p { margin: 0; white-space: pre-wrap; }
+.cp-bubble p + p, .cp-bubble p + ul, .cp-bubble p + ol, .cp-bubble ul + p, .cp-bubble ol + p { margin-top: 8px; }
+.cp-bubble ul, .cp-bubble ol { margin: 0; padding-left: 18px; }
+.cp-bubble li { margin: 3px 0; }
+.cp-bubble code { font: 500 .88em "IBM Plex Mono", monospace; background: rgba(255,255,255,.07); padding: 1px 6px; border-radius: 5px; }
+.cp-chip { display: inline-block; font: 600 .86em "IBM Plex Mono", monospace; color: var(--accent-strong); background: rgba(232,163,58,.12); border: 1px solid rgba(232,163,58,.3); padding: 0 7px; border-radius: 999px; }
+
+.cp-row.theirs .cp-bubble { background: var(--surface-2); border: 1px solid var(--border); color: #e9e7e2; }
+.cp-row.theirs .cp-bubble.tail { border-bottom-left-radius: 6px; }
+.cp-row.mine .cp-bubble { background: linear-gradient(135deg, #f0ad45, #e8a33a); color: #17120b; font-weight: 500; }
+.cp-row.mine .cp-bubble.tail { border-bottom-right-radius: 6px; }
+.cp-row.mine .cp-bubble code { background: rgba(0,0,0,.14); }
+.cp-bubble.error { background: rgba(239,116,100,.09) !important; border: 1px solid rgba(239,116,100,.4) !important; color: #ffb0a4 !important; }
+
+/* typing */
+.cp-bubble.typing { display: inline-flex; gap: 5px; padding: 14px 16px; }
+.cp-bubble.typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); animation: cp-bounce 1.2s infinite ease-in-out; }
+.cp-bubble.typing span:nth-child(2) { animation-delay: .15s; }
+.cp-bubble.typing span:nth-child(3) { animation-delay: .3s; }
+@keyframes cp-bounce { 0%, 60%, 100% { transform: translateY(0); opacity: .4; } 30% { transform: translateY(-5px); opacity: 1; } }
+
+.cp-retry { align-self: flex-start; margin: 10px 0 0 34px; background: transparent; color: var(--accent-strong); border: 1px solid rgba(232,163,58,.4); border-radius: 999px; padding: 6px 14px; font-size: 12px; }
+.cp-retry:hover { background: rgba(232,163,58,.1); }
+
+/* welcome */
+.cp-welcome { text-align: center; padding: 26px 6px 10px; }
+.cp-welcome-avatar { width: 58px; height: 58px; margin: 0 auto 14px; border-radius: 19px; display: grid; place-items: center; background: var(--accent); color: #17120b; font-weight: 900; box-shadow: 0 0 40px rgba(232,163,58,.25); }
+.cp-welcome h4 { margin: 0 0 6px; font-size: 20px; }
+.cp-welcome p { margin: 0 auto; max-width: 290px; color: var(--muted); font-size: 13px; line-height: 1.55; }
+.cp-suggestions { display: grid; gap: 8px; margin-top: 20px; text-align: left; }
+.cp-suggestions button { display: flex; align-items: center; gap: 11px; padding: 12px 14px; background: var(--surface-2); color: var(--text); border: 1px solid var(--border); border-radius: 14px; font-size: 13px; transition: .15s; }
+.cp-suggestions button span { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 9px; background: var(--surface-3); font-size: 14px; }
+.cp-suggestions button:hover:not(:disabled) { border-color: var(--accent); transform: translateX(2px); }
+
+/* jump to bottom */
+.cp-jump { position: absolute; left: 50%; bottom: 96px; transform: translateX(-50%); background: var(--surface-3); color: var(--text); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; font-size: 11px; box-shadow: 0 8px 24px rgba(0,0,0,.4); }
+
+/* composer */
+.cp-foot { padding: 10px 12px 10px; border-top: 1px solid var(--border); background: #121317; }
+.cp-compose { display: flex; align-items: flex-end; gap: 8px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 18px; padding: 6px 6px 6px 14px; transition: border-color .15s; }
+.cp-compose:focus-within { border-color: var(--accent); }
+.cp-compose textarea { flex: 1; resize: none; border: 0; outline: none; background: transparent; color: var(--text); font-size: 14px; line-height: 1.45; padding: 7px 0; max-height: 120px; }
+.cp-compose textarea::placeholder { color: #666b76; }
+.cp-send { width: 36px; height: 36px; flex: none; border: 0; border-radius: 12px; background: var(--accent); color: #17120b; display: grid; place-items: center; }
+.cp-send:disabled { background: var(--surface-3); color: #666b76; }
+.cp-foot-note { margin-top: 7px; text-align: center; color: #5f646f; font-size: 10px; }
+.cp-foot-note code { color: #7b808c; }
+
+@media (max-width: 650px) {
+  .chat-launcher { right: 14px; bottom: 14px; }
+  .cp-panel, .cp-panel.expanded { inset: 0; width: 100%; height: 100dvh; border-radius: 0; border: 0; }
+  .cp-hide-mobile { display: none; }
+  .cp-col { max-width: 86%; }
+}
